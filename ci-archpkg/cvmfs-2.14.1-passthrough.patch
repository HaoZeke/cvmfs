From 190431c0816a7afffa2f4b6f55430d7f94ec3d36 Mon Sep 17 00:00:00 2001
From: Rohit Goswami <rohit.goswami@surf.nl>
Date: Fri, 2 Oct 2026 16:19:09 +0200
Subject: [PATCH 3/3] Close FUSE passthrough backing files on release

libfuse rebuilds fuse_file_info for release from the release request
(flags, fh, lock owner) and never sets backing_id, so cvmfs_release()
always saw backing_id == 0 and skipped its passthrough block. No
backing file was ever closed: the tracker kept every inode opened with
passthrough, and the kernel kept a reference on each backing cache file
until unmount, which cache cleanup cannot reclaim.

Find the tracker entry by inode instead; every open of an inode with
an entry took a reference on it. Raise CAP_SYS_ADMIN around the close
as for the open, and log a failed close instead of asserting.
---
 cvmfs/cvmfs.cc | 31 +++++++++++++++++++------------
 1 file changed, 19 insertions(+), 12 deletions(-)

diff --git a/cvmfs/cvmfs.cc b/cvmfs/cvmfs.cc
index a1b9868de..d21071a62 100644
--- a/cvmfs/cvmfs.cc
+++ b/cvmfs/cvmfs.cc
@@ -1724,27 +1724,34 @@ static void cvmfs_release(fuse_req_t req, fuse_ino_t ino,
       perf::Dec(file_system_->no_open_files());
     }
 #ifdef FUSE_CAP_PASSTHROUGH
-    if (loader_exports_->fuse_passthrough) {
-
-      if (fi->backing_id != 0) {
-        int ret;
-        pthread_mutex_lock(&fuse_passthru_tracker_lock);
-        auto iter = fuse_passthru_tracker->find(ino);
-        assert(iter != fuse_passthru_tracker->end());
+    if (loader_exports_ && loader_exports_->fuse_passthrough
+        && fuse_passthru_tracker) {
+      /* libfuse does not carry backing_id into release (fi is rebuilt from
+       * the release request), so the entry is found by inode. Every open of
+       * an inode while it has an entry took a reference on it. */
+      int ret;
+      pthread_mutex_lock(&fuse_passthru_tracker_lock);
+      auto iter = fuse_passthru_tracker->find(ino);
+      if (iter != fuse_passthru_tracker->end()) {
         fuse_passthru_ctx_t &entry = iter->second;
         assert(entry.refcount > 0);
-        assert(entry.backing_id == fi->backing_id);
         entry.refcount--;
         if (entry.refcount == 0) {
-          ret = fuse_passthrough_close(req, fi->backing_id);
+          const bool raise = !SysAdminCapabilityEffective();
+          if (raise)
+            ObtainSysAdminCapability();
+          ret = fuse_passthrough_close(req, entry.backing_id);
+          if (raise)
+            DropSysAdminCapability();
           if (ret < 0) {
-            LogCvmfs(kLogCvmfs, kLogDebug, "fuse_passthrough_close(fd=%ld) failed: %d", fd, ret);
-            assert(false);
+            LogCvmfs(kLogCvmfs, kLogDebug | kLogSyslogWarn,
+                     "fuse_passthrough_close(backing_id=%d) failed: %d",
+                     entry.backing_id, ret);
           }
           fuse_passthru_tracker->erase(iter);
         }
-        pthread_mutex_unlock(&fuse_passthru_tracker_lock);
       }
+      pthread_mutex_unlock(&fuse_passthru_tracker_lock);
     }
 #endif
   }
-- 
2.55.0

